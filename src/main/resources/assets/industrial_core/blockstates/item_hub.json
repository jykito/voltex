{
  "multipart": [
    { "apply": { "model": "industrial_core:block/item_hub" } },
    { "when": { "down":  "true" }, "apply": { "model": "industrial_core:block/item_hub_port" } },
    { "when": { "north": "true" }, "apply": { "model": "industrial_core:block/item_hub_port", "x": 90, "y": 180 } },
    { "when": { "south": "true" }, "apply": { "model": "industrial_core:block/item_hub_port", "x": 90 } },
    { "when": { "east":  "true" }, "apply": { "model": "industrial_core:block/item_hub_port", "x": 90, "y": 270 } },
    { "when": { "west":  "true" }, "apply": { "model": "industrial_core:block/item_hub_port", "x": 90, "y": 90 } },
    { "when": { "up":    "true" }, "apply": { "model": "industrial_core:block/item_hub_port", "x": 180 } }
  ]
}
