{
  "name": "Automation",
  "entries": [
    {
      "name": "Logistics Node",
      "elements": [
        {
          "type": "header",
          "text": "Logistics Node"
        },
        {
          "type": "text",
          "text": "A network hub: it links points into one logistics network over which items and fluids travel between distant hubs. The node itself does not transfer — it forms the graph."
        },
        {
          "type": "items",
          "items": [
            "industrial_core:logistics_node",
            "industrial_core:logistics_linker"
          ]
        }
      ]
    },
    {
      "name": "Hubs",
      "elements": [
        {
          "type": "header",
          "text": "Item & Fluid Hubs"
        },
        {
          "type": "text",
          "text": "Each of the 6 faces is configurable: input, output, both or off. There are ghost filters (whitelist), limits and round-robin. They transfer locally and across the linked network."
        },
        {
          "type": "items",
          "items": [
            "industrial_core:item_hub",
            "industrial_core:fluid_hub"
          ]
        }
      ]
    },
    {
      "name": "Linker",
      "elements": [
        {
          "type": "header",
          "text": "Linker"
        },
        {
          "type": "text",
          "text": "The linking tool. Click a node, then a hub or device — they join the same network. It also binds the magnet’s remote controller."
        },
        {
          "type": "items",
          "items": [
            "industrial_core:logistics_linker"
          ]
        }
      ]
    },
    {
      "name": "Pushers & Pullers",
      "elements": [
        {
          "type": "header",
          "text": "Pushers & Pullers"
        },
        {
          "type": "text",
          "text": "Upgrades for a machine slot: a pusher ejects the result, a puller draws in input. Separate for items and fluids — basic automation without hubs."
        },
        {
          "type": "items",
          "items": [
            "industrial_core:item_pusher",
            "industrial_core:item_puller",
            "industrial_core:fluid_pusher",
            "industrial_core:fluid_puller"
          ]
        }
      ]
    },
    {
      "name": "Connector Upgrades",
      "elements": [
        {
          "type": "header",
          "text": "Connector Upgrades"
        },
        {
          "type": "text",
          "text": "Placed on a hub face: they speed up the transfer interval and raise per-tick volume and range. higher tiers, from T1 to T3, move more, faster and farther."
        },
        {
          "type": "items",
          "items": [
            "industrial_core:hub_upgrade_t1",
            "industrial_core:hub_upgrade_t2",
            "industrial_core:hub_upgrade_t3"
          ]
        }
      ]
    },
    {
      "name": "Machine Upgrades",
      "elements": [
        {
          "type": "header",
          "text": "Machine Upgrades"
        },
        {
          "type": "text",
          "text": "Upgrades go into a machine’s slots. The accelerator raises speed at the cost of FE. Parallel modules process several operations at once: ×8, ×32 and ×64. Combine them for throughput."
        },
        {
          "type": "text",
          "text": "The blast furnace (forced air, oxygen boost), cultivator (biostimulator, resonator) and logistics (pushers, connector upgrades) have their own upgrades — see their chapters."
        },
        {
          "type": "items",
          "items": [
            "industrial_core:accelerator",
            "industrial_core:parallel_module",
            "industrial_core:advanced_parallel_module",
            "industrial_core:quantum_parallel_module"
          ]
        }
      ]
    },
    {
      "name": "Storage",
      "elements": [
        {
          "type": "header",
          "text": "Crates & Barrels"
        },
        {
          "type": "text",
          "text": "Crates store items (3 tiers by capacity), barrels store fluids (32k to 512k mb). Simple, cheap, and easy to wire into logistics."
        },
        {
          "type": "items",
          "items": [
            "industrial_core:crate_t1",
            "industrial_core:crate_t3",
            "industrial_core:barrel_t1",
            "industrial_core:barrel_t3"
          ]
        }
      ]
    }
  ]
}