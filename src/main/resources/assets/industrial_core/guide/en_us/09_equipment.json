          ]
        }
      ]
    },
    {
      "name": "Energy Backpack",
      "elements": [
        {
          "type": "header",
          "text": "Energy Backpack"
        },
        {
          "type": "text",
          "text": "A wearable battery that charges tools and armor on your body. 3 capacity tiers (1M, 10M and 100M FE) and modes: hand, hotbar or the whole inventory."
