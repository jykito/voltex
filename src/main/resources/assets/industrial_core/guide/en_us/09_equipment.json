            "industrial_core:nexite_leggings",
            "industrial_core:nexite_boots"
          ]
        }
      ]
    },
    {
      "name": "Plasma Armor",
      "elements": [
        {
          "type": "header",
          "text": "Plasma Armor"
        },
        {
          "type": "text",
          "text": "The apex of defense. A huge FE buffer, absorbing up to 100% of damage. A full set grants flight and fire resistance, and on charge — a plasma burst against nearby foes."
        },
        {
          "type": "items",
          "items": [
            "industrial_core:plasma_helmet",
