        {
          "type": "items",
          "items": [
            "industrial_core:energy_backpack_t1",
            "industrial_core:energy_backpack_t2",
            "industrial_core:energy_backpack_t3"
          ]
        }
      ]
    },
    {
      "name": "Nexite Armor",
      "elements": [
        {
          "type": "header",
          "text": "Nexite Armor"
        },
        {
          "type": "text",
          "text": "Energy armor: unbreakable, absorbs damage for FE. Boots negate fall damage; a fully charged set grants Haste. The mid endgame defense tier."
        },
        {
          "type": "items",
          "items": [
